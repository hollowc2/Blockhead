# User-service example for Blockhead on Maia.
# Install under ~/.config/systemd/user/blockhead.service.
# The runtime copy contains code and dependencies; the NFS checkout contains
# the working directory, config, database, and logs.

[Unit]
Description=Blockhead CobbleBob Minecraft bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/Repos/Games/Blockhead
ExecStart=%h/.local/share/blockhead-runtime/node_modules/.bin/tsx %h/.local/share/blockhead-runtime/src/index.ts
Restart=always
RestartSec=5
Environment=LOG_LEVEL=info

[Install]
WantedBy=default.target
