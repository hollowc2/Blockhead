#!/bin/sh
# Update the Maia runtime from the shared source checkout.
# Override SSH_HOST, SOURCE_REPO, RUNTIME_DIR, or SERVICE_NAME as needed.

set -eu

SSH_HOST=${SSH_HOST:-maia}
SOURCE_REPO=${SOURCE_REPO:-/mnt/Repos/Games/Blockhead}
RUNTIME_DIR=${RUNTIME_DIR:-/home/corey/.local/share/blockhead-runtime}
SERVICE_NAME=${SERVICE_NAME:-blockhead.service}

printf 'Updating %s on %s from %s\n' \
  "$RUNTIME_DIR" "$SSH_HOST" "$SOURCE_REPO"

ssh "$SSH_HOST" sh -s -- "$SOURCE_REPO" "$RUNTIME_DIR" "$SERVICE_NAME" <<'REMOTE_SCRIPT'
set -eu

source_repo=$1
runtime_dir=$2
service=$3

cd -- "$source_repo"
git rev-parse --show-toplevel >/dev/null

if ! git diff --quiet || ! git diff --cached --quiet; then
  printf '%s\n' 'Refusing deployment: source checkout has tracked changes.' >&2
  git status --short >&2
  exit 1
fi

printf '%s\n' 'Installing and checking source checkout...'
npm ci
npm run typecheck
npm test

printf 'Syncing runtime copy: %s\n' "$runtime_dir"
mkdir -p -- "$runtime_dir"
rsync -a --delete \
  --exclude .git \
  --exclude node_modules \
  --exclude data \
  --exclude logs \
  "$source_repo/" "$runtime_dir/"

cd -- "$runtime_dir"
npm ci

printf 'Restarting user service: %s\n' "$service"
systemctl --user daemon-reload
systemctl --user restart "$service"
systemctl --user status --no-pager "$service"
REMOTE_SCRIPT
