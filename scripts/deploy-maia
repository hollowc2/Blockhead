#!/bin/sh
# Deploy Blockhead from Zeus to Maia.
# Override SSH_HOST, REMOTE_REPO, SERVICE_NAME, or DEPLOY_BRANCH as needed.

set -eu

SSH_HOST=${SSH_HOST:-maia}
REMOTE_REPO=${REMOTE_REPO:-/srv/blockhead}
SERVICE_NAME=${SERVICE_NAME:-blockhead}
DEPLOY_BRANCH=${DEPLOY_BRANCH:-main}

printf 'Deploying %s branch %s to %s (%s)\n' \
  "$REMOTE_REPO" "$DEPLOY_BRANCH" "$SSH_HOST" "$SERVICE_NAME"

ssh "$SSH_HOST" sh -s -- "$REMOTE_REPO" "$SERVICE_NAME" "$DEPLOY_BRANCH" <<'REMOTE_SCRIPT'
set -eu

repo=$1
service=$2
branch=$3

printf 'Checking checkout: %s\n' "$repo"
cd -- "$repo"
git rev-parse --show-toplevel >/dev/null
status=$(git status --porcelain)
if [ -n "$status" ]; then
  printf '%s\n' "Refusing deployment: Maia checkout has local changes." >&2
  git status --short >&2
  exit 1
fi


current_branch=$(git branch --show-current)
if [ "$current_branch" != "$branch" ]; then
  printf 'Refusing deployment: checkout is on %s, expected %s.\n' \
    "${current_branch:-detached HEAD}" "$branch" >&2
  exit 1
fi

printf 'Updating branch with fast-forward-only pull...\n'
git pull --ff-only origin "$branch"

printf 'Installing dependencies with npm ci...\n'
npm ci

printf 'Running typecheck...\n'
npm run typecheck

printf 'Running tests...\n'
npm test

printf 'Restarting %s...\n' "$service"
sudo systemctl restart "$service"
printf 'Service status:\n'
sudo systemctl status --no-pager "$service"
REMOTE_SCRIPT
